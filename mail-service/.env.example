# À configurer chez l’hébergeur. Ne jamais copier ces valeurs dans public/.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MAIL_PUBLIC_URL=https://votre-service.example
MAIL_ALLOWED_ORIGIN=https://jdsforeal.github.io
# Clé base64 de 32 octets, générée une fois et conservée hors du dépôt.
MAIL_ENCRYPTION_KEY=
# Volume persistant privé. Une seule instance du service.
MAIL_DATA_PATH=/data/atelier-mail.enc
PORT=8787

# Protection du pilote : vide = aucun destinataire autorisé.
MAIL_MODE=sandbox
MAIL_TEST_RECIPIENTS=
# Compte(s) expéditeur(s) autorisé(s) pour le pilote.
MAIL_TEST_ACCOUNTS=
# Configuration publique du projet Supabase ; aucun service_role.
MAIL_REQUIRE_CLOUD=1
ATELIER_SUPABASE_URL=
ATELIER_SUPABASE_KEY=
# Pour des essais sur cet ordinateur uniquement : 127.0.0.1.
MAIL_BIND_HOST=127.0.0.1

# Rédaction facultative. Activer seulement avec une clé issue d’un projet Free Tier sans facturation.
MAIL_AI_ENABLED=0
GEMINI_FREE_TIER_CONFIRMED=0
GEMINI_API_KEY=
# Choisir un modèle actuellement disponible dans le quota gratuit du projet.
GEMINI_MODEL=gemini-3.8-flash
